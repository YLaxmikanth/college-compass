generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CollegeType {
  PUBLIC
  PRIVATE
  DEEMED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("STUDENT")
  bio           String?
  avatarUrl     String?
  savedColleges SavedCollege[]
  reviews       Review[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model College {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  city            String
  state           String
  type            CollegeType
  category        String
  tuition         Int
  acceptanceRate  Float
  rating          Float
  ranking         Int
  overview        String
  website         String
  featuredImage   String
  establishedYear Int
  placements      String
  averagePackage  Float?
  highestPackage  Float?
  placementRate   Float?
  hostels         Boolean        @default(false)
  scholarships    Boolean        @default(false)
  aiEnabled       Boolean        @default(false)
  courses         Course[]
  reviews         Review[]
  savedBy         SavedCollege[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([city, state])
  @@index([type])
  @@index([rating])
  @@index([tuition])
}

model Course {
  id        String   @id @default(cuid())
  name      String
  duration  String
  degree    String
  seatCount Int
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Review {
  id         String       @id @default(cuid())
  title      String
  content    String
  rating     Int
  status     ReviewStatus @default(PENDING)
  collegeId  String
  userId     String?
  college    College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([collegeId])
  @@index([userId])
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, collegeId])
  @@index([collegeId])
}
